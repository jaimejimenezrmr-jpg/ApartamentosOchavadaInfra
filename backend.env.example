# =====================================================================================
# Secretos y configuración del backend. Copiar a backend.env (nunca versionar backend.env).
# La base de datos, el dominio (JWT_ISSUER, CORS, enlaces del portal) y los datos del establecimiento
# los define docker-compose.yml a partir de .env.
# =====================================================================================

# --- JWT (openssl rand -base64 48) ---
JWT_SECRET=

# --- Cifrado de credenciales de integraciones guardadas en BD (openssl rand -base64 32) ---
APP_CREDENTIALS_KEY=

# --- Stripe (claves live en producción) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Dashboard > Developers > Webhooks > endpoint https://<DOMAIN>/api/v1/webhooks/stripe
# Eventos: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.processing,
#          payment_intent.requires_action, payment_intent.canceled
STRIPE_WEBHOOK_SECRET=

# --- Email (Gmail: contraseña de aplicación; requiere verificación en 2 pasos) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=apartamentosochavada@gmail.com
SMTP_PASSWORD=
MAIL_FROM=apartamentosochavada@gmail.com
MAIL_REPLY_TO=

# --- TTLock ---
TTLOCK_ENABLED=false
TTLOCK_BASE_URL=https://euapi.ttlock.com
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD=

# --- SES.HOSPEDAJES (pre-producción hasta validar el envío; después, la URL de producción que indique el Ministerio) ---
SES_ENABLED=false
SES_ENDPOINT=https://hospedajes.pre-ses.mir.es/hospedajes-web/ws/v1/comunicacion
SES_USERNAME=
SES_PASSWORD=
SES_LANDLORD_CODE=
SES_ESTABLISHMENT_CODE=
SES_REPORT_RESERVATIONS=true
# Solo si hace falta: fichero en ./secrets montado en /app/secrets
SES_TRUSTSTORE_PATH=
SES_TRUSTSTORE_PASSWORD=

# --- Facturación ---
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_TAX_ID=
INVOICE_ISSUER_ADDRESS=Calle Pescaderías, 6, 14920 Aguilar de la Frontera (Córdoba)
VERIFACTU_ENABLED=false

# --- Beds24 ---
BEDS24_ENABLED=false
BEDS24_REFRESH_TOKEN=
# Cabecera X-Ochavada-Webhook-Token del webhook de Beds24 (openssl rand -hex 32)
BEDS24_WEBHOOK_TOKEN=
BEDS24_SYNC_HORIZON_DAYS=365
BEDS24_OTA_COLLECT_CHANNELS=airbnb,expedia
BEDS24_PUSH_BOOKINGS=true

# --- Administrador inicial: rellenar para el primer arranque y vaciar después ---
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=Administrador
