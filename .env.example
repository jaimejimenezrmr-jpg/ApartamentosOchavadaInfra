# =====================================================================================
# Variables de Docker Compose (proxy, base de datos y web). Copiar a .env (nunca versionar .env).
# Los secretos del backend (Stripe, SMTP, TTLock, SES, Beds24...) van en backend.env.
# =====================================================================================

# --- Dominio ---
# Dominio principal (sin https://). www.<dominio> redirige a él. Ambos deben existir en la zona DNS de Cloudflare.
DOMAIN=apartamentosochavada.com
# Avisos de Let's Encrypt sobre los certificados
ACME_EMAIL=apartamentosochavada@gmail.com
# Cloudflare > My Profile > API Tokens > "Edit zone DNS" limitado a la zona del dominio
CLOUDFLARE_API_TOKEN=

# --- Base de datos (openssl rand -base64 32) ---
POSTGRES_DB=ochavada
POSTGRES_USER=ochavada
POSTGRES_PASSWORD=

# --- Datos del establecimiento mostrados en la web, emails y facturas ---
PROPERTY_NAME=Apartamentos Ochavada
PROPERTY_LEGAL_NAME=
PROPERTY_TAX_ID=
PROPERTY_ADDRESS=Calle Pescaderías, 6, 14920 Aguilar de la Frontera (Córdoba)
PROPERTY_PHONE=
PROPERTY_EMAIL=apartamentosochavada@gmail.com
# Número de inscripción en el Registro de Turismo de Andalucía (obligatorio en la publicidad)
PROPERTY_TOURISM_REGISTRY=

# --- Copias de seguridad ---
BACKUP_HOUR=4
BACKUP_RETENTION_DAYS=14

# --- Límite de memoria por contenedor ---
# Vacíos = valores para un VPS de 4 GB (backend 1280m, postgres 512m, frontend 384m, caddy y copia 128m).
# Para un VPS de 8 GB (p. ej. tras ampliar a OVHcloud VPS-2): 1536m, 1g, 512m, 256m y 256m.
BACKEND_MEM_LIMIT=
POSTGRES_MEM_LIMIT=
FRONTEND_MEM_LIMIT=
CADDY_MEM_LIMIT=
BACKUP_MEM_LIMIT=
# Conexiones del backend a PostgreSQL (vacío = 10)
DB_POOL_SIZE=

# --- Versión de las imágenes (etiqueta con la que se construyen) ---
IMAGE_TAG=latest
